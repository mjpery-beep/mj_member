<div class="mj-schedule mj-schedule--recurring mj-schedule--weekly">
    {% if summary %}
        <p class="mj-schedule__summary">{{ summary }}</p>
    {% endif %}

    {% if weekly.show_date_range and primary_label %}
        <p class="mj-schedule__period">{{ primary_label }}</p>
    {% endif %}

    {% if weekly.days|length > 0 %}
        <ul class="mj-schedule__list">
            {% for day in weekly.days %}
                <li class="mj-schedule__item">
                    <span class="mj-schedule__item-day">{{ day.label }}</span>
                    {% if day.time_range %}
                        <span class="mj-schedule__item-time">{{ day.time_range }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if next_occurrence_label %}
        <p class="mj-schedule__next">{{ next_occurrence_label }}</p>
    {% endif %}
</div>
